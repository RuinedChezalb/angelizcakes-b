generator client {
  provider                    = "prisma-client-py"
  recursive_type_depth        = 5
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  password                String
  role                    String    @default("admin")
  permissions             String[]
  assignedBranchId        Int?
  isActive                Boolean   @default(true)
  lastLogin               DateTime?
  canManipulateOrders     Boolean   @default(true)
  canManipulateInventory  Boolean   @default(true)
  canViewReports          Boolean   @default(true)
  canManipulateCustomers  Boolean   @default(false)
  canManipulateUsers      Boolean   @default(false)
  canManipulatePromotions Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  mustChangePassword      Boolean   @default(false)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  changedBy String
  branchId  Int?
  details   String?
  createdAt DateTime @default(now())
}

model Branch {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  location          String?
  phone             String?
  email             String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  BranchDailyReport BranchDailyReport[]
  BranchInventory   BranchInventory[]
  BranchSettings    BranchSettings?
  BranchTimeSlot    BranchTimeSlot[]
  CateringBooking   CateringBooking[]
  Conversation      Conversation[]
  CustomCakeRequest CustomCakeRequest[]
  CustomerFeedback  CustomerFeedback[]
  HeldOrder         HeldOrder[]
  Inquiry           Inquiry[]
  InventoryLot      InventoryLot[]
  Notification      Notification[]
  Order             Order[]
  ProductCategory   ProductCategory[]
  SecurityIncident  SecurityIncident[]
  StaffMember       StaffMember[]
  StaffShift        StaffShift[]
  SupportTicket     SupportTicket[]
}

model BranchDailyReport {
  id          Int      @id @default(autoincrement())
  branchId    Int
  reportDate  DateTime @db.Date
  managerName String
  reportData  Json
  submittedAt DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, reportDate])
}

model BranchInventory {
  id                Int      @id @default(autoincrement())
  branchId          Int
  productId         Int
  quantity          Int
  price             Decimal  @db.Decimal(12, 2)
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

model BranchSettings {
  id             Int              @id @default(autoincrement())
  branchId       Int              @unique
  branchOpen     Boolean          @default(true)
  operatingHours Json
  cutoffTime     String?
  sameDayOrders  Boolean          @default(false)
  capacities     Json
  utilization    Json?
  announcement   String?
  currentSlotId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  timeSlots BranchTimeSlot[]
}

model BranchTimeSlot {
  id             String          @id
  branchId       Int
  settingsId     Int?
  label          String
  startTime      String
  endTime        String
  capacity       Int
  utilization    Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  settings BranchSettings? @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([branchId, isActive])
}

model CateringBooking {
  id         String    @id
  customerId Int?
  branchId   Int?
  clientName String
  phone      String?
  email      String?
  eventDate  DateTime  @db.Date
  eventTime  String?
  eventType  String
  venue      String?
  guestCount Int?
  total      Decimal   @db.Decimal(12, 2)
  deposit    Decimal   @default(0) @db.Decimal(12, 2)
  status     String    @default("pending")
  notes      String?
  menu       Json?
  staff      Json?
  checklist  Json?
  setupTime  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  branch     Branch?   @relation(fields: [branchId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId, eventDate, status])
  @@index([customerId, eventDate])
}

model CateringPackage {
  id           String   @id
  category     String
  title        String
  description  String
  imageUrl     String
  includes     Json
  priceOptions Json
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([isActive, category, sortOrder])
}

model Conversation {
  id                  String                @id
  customerId          Int?
  branchId            Int?
  contactName         String
  contact             String?
  email               String?
  channel             String
  topic               String?
  status              String                @default("open")
  isOnline            Boolean               @default(false)
  isVip               Boolean               @default(false)
  unreadCount         Int                   @default(0)
  filterType          String?
  tag                 String?
  customerSince       String?
  recentOrders        Json?
  internalNote        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  branch              Branch?               @relation(fields: [branchId], references: [id])
  customer            Customer?             @relation(fields: [customerId], references: [id])
  messages ConversationMessage[]

  @@index([branchId, status, updatedAt])
  @@index([customerId, updatedAt])
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId String
  direction      String
  content        String
  sentAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model CustomCakeReferenceImage {
  id                Int               @id @default(autoincrement())
  requestId         Int
  storageKey        String            @unique
  fileName          String
  contentType       String?
  createdAt         DateTime          @default(now())
  imageData         String?
  request CustomCakeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model CustomCakeRequest {
  id                       Int                        @id @default(autoincrement())
  requestNumber            String                     @unique
  customerId               Int?
  branchId                 Int?
  contactName              String
  contactPhone             String
  contactEmail             String?
  occasion                 String
  size                     String
  sizePrice                Decimal                    @db.Decimal(12, 2)
  layers                   String
  layersCount              Int
  flavor                   String
  frosting                 String
  frostingColor            String?
  theme                    String
  themeTopper              String?
  color                    String
  colorSwatch              String?
  dedication               String?
  requestedDate            DateTime                   @db.Date
  fulfillmentMethod        String
  fulfillmentFee           Decimal                    @default(0) @db.Decimal(12, 2)
  notes                    String?
  dueTime                  String?
  productionStage          String                     @default("design")
  priority                 String                     @default("medium")
  assignedStaffId          String?
  internalNotes            String?
  quotedTotal              Decimal?                   @db.Decimal(12, 2)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  preferredPaymentMethod   String?
  selectionBasePrice       Decimal                    @default(0) @db.Decimal(12, 2)
  tiers                    String                     @default("1 Tier")
  tiersCount               Int                        @default(1)
  referenceImages CustomCakeReferenceImage[]
  assignedStaff              StaffMember?               @relation(fields: [assignedStaffId], references: [id])
  branch                   Branch?                    @relation(fields: [branchId], references: [id])
  customer                 Customer?                  @relation(fields: [customerId], references: [id])
  orderItems                OrderItem[]

  @@index([assignedStaffId, requestedDate])
  @@index([branchId, productionStage, requestedDate])
  @@index([customerId, createdAt])
}

model Customer {
  id                         Int                 @id @default(autoincrement())
  email                      String              @unique
  phone                      String?
  name                       String
  address                    String?
  city                       String?
  postalCode                 String?
  preferredContactMethod     String              @default("email")
  isActive                   Boolean             @default(true)
  isBlocked                  Boolean             @default(false)
  blockedReason              String?
  totalSpent                 Decimal             @default(0) @db.Decimal(12, 2)
  orderCount                 Int                 @default(0)
  customerSince              DateTime            @default(now())
  lastOrderDate              DateTime?
  favoriteProducts           Int[]               @default([])
  specialRequests            String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime
  passwordHash               String?
  birthday                   DateTime?           @db.Date
  channel                    String?
  preferences                Json?
  tags                       String[]            @default([])
  emailVerified              Boolean             @default(false)
  emailVerificationCodeHash  String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?
  emailVerificationAttempts  Int                 @default(0)
  passwordResetCodeHash      String?
  passwordResetExpiresAt     DateTime?
  passwordResetSentAt        DateTime?
  passwordResetAttempts      Int                 @default(0)
  cateringBookings            CateringBooking[]
  conversations               Conversation[]
  customCakeRequests          CustomCakeRequest[]
  feedback           CustomerFeedback[]
  googleAccount              GoogleAccount?
  inquiries                    Inquiry[]
  orders                      Order[]
  supportTickets              SupportTicket[]
}

model CustomerFeedback {
  id           String    @id
  customerId   Int?
  orderId      Int?
  branchId     Int?
  customerName String?
  rating       Int?
  message      String
  source       String?
  status       String    @default("new")
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  branch       Branch?   @relation(fields: [branchId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])

  @@index([branchId, status, submittedAt])
  @@index([customerId, submittedAt])
}

model CustomizationOption {
  id              String   @id
  step            Int
  field           String
  value           String
  displayName     String?
  description     String?
  price           Decimal? @db.Decimal(12, 2)
  count           Int?
  color           String?
  topper          String?
  swatch          String?
  fulfillmentType String?
  location        String?
  fee             Decimal? @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@unique([step, field, value])
  @@index([step, field, isActive, sortOrder])
}

model FacebookAccount {
  id           Int      @id @default(autoincrement())
  facebookId   String   @unique
  name         String?
  email        String?
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model GoogleAccount {
  id           Int       @id @default(autoincrement())
  googleId     String    @unique
  name         String?
  email        String?
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  phoneNumber  String?
  customerId   Int?      @unique
  customer     Customer? @relation(fields: [customerId], references: [id])
}

model HeldOrder {
  id              String    @id
  customerName    String?
  customerContact String?
  fulfillment     String?
  total           Decimal   @db.Decimal(12, 2)
  items           Json
  status          String    @default("held")
  heldAt          DateTime  @default(now())
  resumedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  branchId        Int?
  branch          Branch?   @relation(fields: [branchId], references: [id])

  @@index([branchId, status, heldAt])
  @@index([status, heldAt])
}

model Inquiry {
  id              String    @id
  customerId      Int?
  branchId        Int?
  customerName    String
  phone           String?
  email           String?
  eventDate       DateTime? @db.Date
  summary         String
  type            String
  estimatedBudget Decimal?  @db.Decimal(12, 2)
  status          String    @default("new")
  details         Json?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  branch          Branch?   @relation(fields: [branchId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
}

model InventoryLot {
  id         String    @id
  branchId   Int
  productId  Int?
  itemName   String
  category   String
  batchCode  String
  quantity   Int
  minStock   Int       @default(0)
  unit       String
  receivedAt DateTime  @db.Date
  expiresAt  DateTime? @db.Date
  unitPrice  Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id])

  @@index([batchCode])
  @@index([branchId, category])
  @@index([branchId, expiresAt])
}

model Notification {
  id          String   @id
  branchId    Int?
  category    String
  categoryKey String?
  priority    String
  iconType    String?
  title       String
  message     String
  isRead      Boolean  @default(false)
  details     Json?
  actions     Json?
  createdAt   DateTime @default(now())
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, isRead, createdAt])
}

model Order {
  id                    Int                @id @default(autoincrement())
  customerId            Int
  branchId              Int
  status                String             @default("pending")
  orderDate             DateTime           @default(now())
  deliveryDate          DateTime?
  deliveryTime          String?
  deliveryAddress       String?
  deliveryCity          String?
  deliveryPostalCode    String?
  isPickup              Boolean            @default(false)
  subtotal              Decimal            @db.Decimal(12, 2)
  discountAmount        Decimal            @default(0) @db.Decimal(12, 2)
  promotionCode         String?
  taxAmount             Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal            @db.Decimal(12, 2)
  paymentMethod         String?
  paymentStatus         String             @default("pending")
  specialInstructions   String?
  rating                Int?
  feedback              String?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  paymentIntentId       String?            @unique
  paymentIntentCreating Boolean            @default(false)
  channel               String?
  paymentEnvironment    String?
  isForSomeoneElse      Boolean            @default(false)
  recipientName         String?
  recipientPhone        String?
  customerFeedback      CustomerFeedback[]
  branch                Branch             @relation(fields: [branchId], references: [id])
  customer              Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  paymentAttempts        PaymentAttempt[]
}

model OrderItem {
  id                  Int                @id @default(autoincrement())
  orderId             Int
  productId           Int?
  quantity            Int
  pricePerUnit        Decimal            @db.Decimal(12, 2)
  subtotal            Decimal            @db.Decimal(12, 2)
  customizations      String?
  createdAt           DateTime           @default(now())
  customCakeRequestId Int?
  customCakeRequest   CustomCakeRequest? @relation(fields: [customCakeRequestId], references: [id])
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?           @relation(fields: [productId], references: [id])
}

model PaymentAttempt {
  id                Int      @id @default(autoincrement())
  orderId           Int
  environment       String
  paymentIntentId   String   @unique
  providerPaymentId String?
  status            String
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("PHP")
  paymentMethod     String?
  lastEventType     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  Order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([environment, status])
  @@index([orderId, createdAt])
}

model PortfolioImage {
  id          Int      @id @default(autoincrement())
  title       String
  altText     String?
  imageUrl    String?
  imageData   String?
  contentType String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isActive, sortOrder])
}

model Product {
  id                 Int               @id @default(autoincrement())
  sku                String            @unique
  name               String
  description        String?
  basePrice          Decimal           @db.Decimal(12, 2)
  category           String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  categoryId         Int?
  subCategory        String?
  imageUrl           String?
  cost               Decimal?          @db.Decimal(12, 2)
  classification     Json?
  tag                String?
  ingredients        Json?
  allergens          String?
  flavors            Json?
  showPOS            Boolean           @default(true)
  showOnline         Boolean           @default(true)
  allowCustomization Boolean           @default(false)
  branchInventories    BranchInventory[]
  inventoryLots       InventoryLot[]
  orderItems          OrderItem[]
  catalogCategory    ProductCategory?  @relation(fields: [categoryId], references: [id])
  productImages       ProductImage[]

  @@index([categoryId])
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  branchId    Int?
  name        String
  description String?
  color       String?
  iconType    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  products     Product[]
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, name])
  @@index([isActive, sortOrder])
}

model ProductImage {
  id          Int      @id @default(autoincrement())
  productId   Int
  imageData   String
  contentType String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Promotion {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  code               String   @unique
  discountType       String
  discountValue      Decimal  @db.Decimal(12, 2)
  applicableProducts Int[]    @default([])
  applicableBranches Int[]    @default([])
  maxUses            Int?
  usedCount          Int      @default(0)
  maxUsesPerCustomer Int?
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean  @default(true)
  minOrderValue      Decimal? @db.Decimal(12, 2)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime
}

model SalesReport {
  id                 Int      @id @default(autoincrement())
  branchId           Int?
  date               DateTime
  totalOrders        Int
  totalRevenue       Decimal  @db.Decimal(12, 2)
  totalCustomers     Int
  averageOrderValue  Decimal  @db.Decimal(12, 2)
  totalDiscount      Decimal  @db.Decimal(12, 2)
  topProduct         String?
  topProductQuantity Int?
  createdAt          DateTime @default(now())
}

model SecurityIncident {
  id               String   @id
  branchId         Int?
  targetName       String
  targetType       String
  issueType        String
  dateReported     DateTime @default(now())
  financialImpact  Decimal? @db.Decimal(12, 2)
  status           String   @default("open")
  description      String
  notes            String?
  evidence         Json?
  restrictions     Json?
  escalationReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Branch           Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId, status, dateReported])
}

model StaffMember {
  id                    String              @id
  branchId              Int?
  name                  String
  role                  String
  email                 String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  access                Json?
  duty                  String?
  status                String              @default("active")
  lastLogin             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime
  customCakeRequests     CustomCakeRequest[]
  branch                Branch?             @relation(fields: [branchId], references: [id])
  shifts            StaffShift[]

  @@index([branchId, status])
}

model StaffShift {
  id               String      @id
  staffId          String
  branchId         Int?
  date             DateTime    @db.Date
  shiftType        String
  scheduledIn      String
  scheduledOut     String
  timeIn           String?
  timeOut          String?
  status           String
  isLate           Boolean     @default(false)
  hours            Decimal?    @db.Decimal(6, 2)
  duty             String?
  tasks            Json?
  notes            String?
  overtimeApproved Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  branch           Branch?     @relation(fields: [branchId], references: [id])
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([branchId, date, status])
  @@index([staffId, date])
}

model SuperAdmin {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  password                String
  role                    String   @default("super_admin")
  permissions             String[]
  managedBranches         Int[]    @default([])
  canManipulateBranches   Boolean  @default(true)
  canManipulateUsers      Boolean  @default(true)
  canManipulateAdmins     Boolean  @default(true)
  canManipulateCustomers  Boolean  @default(true)
  canManipulateOrders     Boolean  @default(true)
  canManipulateInventory  Boolean  @default(true)
  canManipulatePromotions Boolean  @default(true)
  canViewReports          Boolean  @default(true)
  canViewAuditLogs        Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime
  mustChangePassword      Boolean  @default(false)
}

model SupportTicket {
  id                      String                    @id
  customerId              Int?
  branchId                Int?
  author                  String
  category                String
  priority                String
  subject                 String
  description             String
  status                  String                    @default("open")
  submittedAt             DateTime                  @default(now())
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  branch                  Branch?                   @relation(fields: [branchId], references: [id])
  customer                Customer?                 @relation(fields: [customerId], references: [id])
  attachments SupportTicketAttachment[]
  replies      SupportTicketReply[]

  @@index([branchId, status, priority])
  @@index([customerId, createdAt])
}

model SupportTicketAttachment {
  id            Int           @id @default(autoincrement())
  ticketId      String
  fileName      String
  storageKey    String        @unique
  contentType   String?
  createdAt     DateTime      @default(now())
  fileData      String?
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicketReply {
  id            Int           @id @default(autoincrement())
  ticketId      String
  author        String
  message       String
  createdAt     DateTime      @default(now())
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model notes {
  id         BigInt   @id @default(autoincrement())
  author     String   @db.VarChar(40)
  body       String   @db.VarChar(280)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}
