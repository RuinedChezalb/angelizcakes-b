generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  BRANCH_MANAGER
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum BranchStatus {
  OPEN
  CLOSED
}

enum OrderSource {
  STOREFRONT
  BRANCH
  POS
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum RequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InquiryStatus {
  NEW
  OPEN
  REPLIED
  CLOSED
}

enum LoginResult {
  SUCCESSFUL
  FAILED
}

model User {
  id              String        @id @default(cuid())
  firstName       String
  lastName        String
  email           String        @unique
  phone           String?
  passwordHash    String
  role            UserRole      @default(CUSTOMER)
  status          AccountStatus @default(ACTIVE)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerProfile Customer?
  loginAttempts   LoginAttempt[]
  sessions        UserSession[]
  activityLogs    ActivityLog[]
  shifts          ShiftHandover[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([branchId, role, status])
}

model Branch {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  address         String
  phone           String?
  email           String?
  operatingHours  String?
  openedAt        DateTime?
  status          BranchStatus   @default(OPEN)
  users           User[]
  orders          Order[]
  inventoryBatches InventoryBatch[]
  stockRequests   StockRequest[]
  posTransactions PosTransaction[]
  dailyReports    DailyReport[]
  shifts          ShiftHandover[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String   @unique
  phone       String?
  address     String?
  birthday    DateTime?
  notes       String?
  orders      Order[]
  inquiries   Inquiry[]
  favorites   Favorite[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoginAttempt {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String?
  email       String
  attemptedAt DateTime    @default(now())
  device      String?
  result      LoginResult
  ipAddress   String?

  @@index([email, attemptedAt])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       String?
  ipAddress    String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, expiresAt])
}

model Product {
  id          String        @id @default(cuid())
  sku         String?       @unique
  name        String
  category    String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  image       String?
  showInPos   Boolean       @default(true)
  status      ProductStatus @default(ACTIVE)
  ingredients String?
  allergens   String?
  classification String?
  details     Json?
  orderItems  OrderItem[]
  inventory   InventoryBatch[]
  packageInclusions PackageInclusion[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, status])
}

model CakePreset {
  id             String        @id @default(cuid())
  name           String
  price          Decimal       @db.Decimal(12, 2)
  image          String?
  classification String?
  ingredients    String?
  allergens      String?
  details        Json?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CustomizationStep {
  id        String                     @id @default(cuid())
  key       String                     @unique
  label     String
  sortOrder Int                        @default(0)
  options   CustomizationOption[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
}

model CustomizationOption {
  id        String            @id @default(cuid())
  stepId    String
  step      CustomizationStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label     String
  price     Decimal?          @db.Decimal(12, 2)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([stepId, label])
  @@index([stepId, sortOrder])
}

model ServicePackage {
  id          String              @id @default(cuid())
  category    String
  name        String
  pax         String?
  price       Decimal             @db.Decimal(12, 2)
  description String?
  image       String?
  status      ProductStatus       @default(ACTIVE)
  inclusions  PackageInclusion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([category, status])
}

model PackageInclusion {
  id        String         @id @default(cuid())
  packageId String
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity  String
  name      String
  sortOrder Int            @default(0)
}

model Promotion {
  id        String    @id @default(cuid())
  name      String
  targets   String[]
  discount  Decimal   @db.Decimal(5, 2)
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  referenceNo       String?           @unique
  sequence          Int?
  source            OrderSource
  type              String
  flow              String?
  branchType        String?
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  paymentMethod     String?
  amount            Decimal           @default(0) @db.Decimal(12, 2)
  amountLabel       String?
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String?
  customerPhone     String?
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fulfillment       FulfillmentMethod?
  deliveryAddress   String?
  recipientName     String?
  recipientContact  String?
  recipientAddress  String?
  giftMessage       String?
  requestedDate     DateTime?
  requestedTime     String?
  additionalInfo    String?
  itemSpecifications String?
  dedication        String?
  selections        Json?
  referenceImages   Json?
  productSnapshot   Json?
  packageSnapshot   Json?
  pricingSnapshot   Json?
  contactSnapshot   Json?
  recipientSnapshot Json?
  scheduleSnapshot  Json?
  summarySnapshot   Json?
  items             OrderItem[]
  placedAt          DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([branchId, status, placedAt])
  @@index([customerId, placedAt])
  @@index([source, placedAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  category    String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  details     Json?
}

model StockRequest {
  id          String        @id @default(cuid())
  reference   String        @unique
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Int
  neededBy    DateTime?
  urgency     Urgency       @default(NORMAL)
  reason      String?
  status      RequestStatus @default(SUBMITTED)
  submittedAt DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([branchId, status, submittedAt])
}

model InventoryBatch {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  category     String?
  quantity     Int
  unit         String?
  receivedAt   DateTime @default(now())
  expiresAt    DateTime?
  source       String?
  dispatchedAt DateTime?
  destination  String?
  createdAt    DateTime @default(now())

  @@index([branchId, expiresAt])
}

model PosTransaction {
  id            String             @id @default(cuid())
  transactionNo String             @unique
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashierId     String?
  customerName  String             @default("Walk-in Customer")
  customerEmail String?
  subtotal      Decimal            @db.Decimal(12, 2)
  total         Decimal            @db.Decimal(12, 2)
  paymentStatus PaymentStatus      @default(PAID)
  itemsCount    Int
  items         PosTransactionItem[]
  timestamp     DateTime           @default(now())

  @@index([branchId, timestamp])
}

model PosTransactionItem {
  id            String         @id @default(cuid())
  transactionId String
  transaction   PosTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String?
  name          String
  unitPrice     Decimal        @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal        @db.Decimal(12, 2)
}

model DailyReport {
  id                 String   @id @default(cuid())
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reportDate         DateTime @db.Date
  successCake        Int      @default(0)
  successGrazing     Int      @default(0)
  successBuffet      Int      @default(0)
  successBundles     Int      @default(0)
  successPackages    Int      @default(0)
  totalSales         Decimal  @default(0) @db.Decimal(12, 2)
  actualCash         Decimal  @default(0) @db.Decimal(12, 2)
  closingNotes       String?
  confirmed          Boolean  @default(false)
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())

  @@unique([branchId, reportDate])
}

model ShiftHandover {
  id                 String   @id @default(cuid())
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  outgoingUserId     String?
  outgoingUser       User?    @relation(fields: [outgoingUserId], references: [id], onDelete: SetNull)
  incomingStaff      String?
  shiftDate          DateTime @db.Date
  duration           String?
  transactions       Int      @default(0)
  totalSales         Decimal  @default(0) @db.Decimal(12, 2)
  inquiries          Int      @default(0)
  orders             Int      @default(0)
  remarks            String?
  handoverStatus     String?
  createdAt          DateTime @default(now())

  @@index([branchId, shiftDate])
}

model Inquiry {
  id          String        @id @default(cuid())
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  email       String
  subject     String
  details     String
  status      InquiryStatus @default(NEW)
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([email, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productKey String
  createdAt  DateTime @default(now())

  @@unique([customerId, productKey])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
