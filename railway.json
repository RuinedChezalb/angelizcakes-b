{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "variables": {
    "APP_ENV": "production",
    "PAYMONGO_MODE": "test",
    "DOMAIN": "www.angelizcakes.site",
    "FRONTEND_ORIGINS": "https://www.angelizcakes.site,https://angelizgourmetbakeshop.up.railway.app",
    "ADDITIONAL_TRUSTED_HOSTS": "angelizgourmetbakeshop.up.railway.app",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Angeliz Cakes <no-reply@angelizcakes.site>"
  }
}
